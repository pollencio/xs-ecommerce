SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional. Printed after your first `npm run deploy`. Setting it silences
# the "add appId to sanity.cli.ts" reminder on later deploys — it's
# per-deployment, so it stays out of sanity.cli.ts itself and lives here
# instead, same as the two variables above.
# SANITY_STUDIO_APP_ID=
